# Shared template for the whole team (backend + root ENS scripts + contracts).
# Copy to .env (gitignored) and fill in. Never commit real values.
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
PACT_ETH_OWNER_PRIVATE_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
WORLD_APP_ID=
WORLD_ACTION_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
USDC_SEPOLIA_ADDRESS=
PACT_REGISTRY_ADDRESS=
PACT_ESCROW_ADDRESS=
# ENS root all subnames live under. pact-hack.eth is what's registered on
# Sepolia; switch to pact.eth only after it is registered + verified.
ENS_ROOT_NAME=pact-hack.eth
# Backend only
PORT=4000
DEV_WORLD_STUB=true
ALLOW_DEV_AUTH=false
DATABASE_URL=
